# Runtime: cole a URL real do painel Connect do Supabase (session ou transaction pooler).
DATABASE_URL=""
MYSTRA_ENV="development"
# Versão 1.0: na Vercel use production e cadastre credenciais somente em Production.
# Preserve o .env local existente; demo/homologação não são requisitos deste deploy.
PRIMARY_SUPABASE_PROJECT_REF=""
# CLI/migrations: direct se houver IPv6, ou session pooler IPv4 na porta 5432.
DIRECT_URL=""
# Somente migrate dev: banco shadow separado, nunca o banco principal.
SHADOW_DATABASE_URL=""
BETTER_AUTH_URL="http://localhost:3000"
# Na Vercel: origem HTTPS canônica exata, igual a SITE_URL. Nunca wildcard *.vercel.app.
# Origem pública real para canonical, Open Graph e dados estruturados (opcional no desenvolvimento).
SITE_URL=""
# Indexação exige produção, SITE_URL HTTPS e autorização no SEO institucional.
SITE_INDEXING_ENABLED="false"
# Gere um segredo aleatório com pelo menos 32 caracteres.
BETTER_AUTH_SECRET=""
# Storage: valores reais do projeto, exclusivamente no servidor.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""
# Testes de integração opcionais: banco PostgreSQL de testes separado.
TEST_DATABASE_URL=""
TEST_DATABASE_ISOLATED="false"
# Chave dos formulários públicos (32+ caracteres); usa BETTER_AUTH_SECRET se esta estiver vazia.
CRM_FORM_SECRET=""
# Bucket comercial PRIVADO, distinto da biblioteca editorial.
SUPABASE_LEADS_BUCKET=""
# Somente canais institucionais reais; vazio = não exibir.
CONTACT_EMAIL=""
CONTACT_HOURS=""
CONTACT_SOCIAL_LINKS="[]"
# Revisão operacional de inscrições antigas; não define retenção legal nem ativa exclusão.
EVENT_REGISTRATION_REVIEW_DAYS=""
# Careers: demo é o padrão seguro. Nunca habilite coleta sem revisão operacional.
CAREERS_MODE="demo"
CAREERS_CONTROLLED_TEST="false"
CAREERS_PREPARE_TEST="false"
CAREERS_PRIVACY_REVIEWED="false"
CAREERS_SECURITY_REVIEWED="false"
CAREERS_CONTROLLER_NAME=""
CAREERS_PRIVACY_CONTACT_EMAIL=""
CAREERS_RETENTION_DAYS=""
CAREERS_MAX_CV_MB="5"
# Bucket de currículos privado e separado dos buckets editorial e comercial.
SUPABASE_CAREERS_BUCKET=""
