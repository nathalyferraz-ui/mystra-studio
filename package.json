{
  "name": "mystra-studio",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "next dev",
    "env:demo": "tsx scripts/environment-run.ts demo",
    "env:homolog": "tsx scripts/environment-run.ts homologation",
    "demo:plan": "tsx scripts/demo.ts plan",
    "demo:check": "tsx scripts/check-demo.ts",
    "demo:tls": "tsx scripts/configure-demo-tls.ts",
    "demo:prepare": "tsx scripts/demo.ts prepare",
    "demo:seed": "tsx scripts/demo.ts seed",
    "demo:restore": "tsx scripts/demo.ts restore",
    "demo:account": "tsx scripts/demo.ts account",
    "build": "next build",
    "build:vercel": "tsx scripts/check-production.ts && prisma generate && next build",
    "release:check": "tsx scripts/check-production.ts",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:init": "tsx scripts/bootstrap-admin.ts",
    "auth:configure": "tsx scripts/configure-auth.ts",
    "test": "tsx --test tests/*.test.ts",
    "audit:browser": "node scripts/audit-browser.mjs",
    "audit:v1": "node scripts/audit-v1.mjs",
    "preview:admin-ui": "node scripts/preview-admin.mjs",
    "audit:admin-ui": "node scripts/audit-admin-ui.mjs",
    "audit:demo-ui": "node scripts/audit-demo-ui.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:check": "tsx scripts/check-db.ts",
    "crm:retention-report": "tsx scripts/crm-retention-report.ts",
    "eventos:retention-report": "tsx scripts/events-retention-report.ts",
    "careers:retention-report": "tsx scripts/careers-retention-report.ts",
    "careers:prepare-test": "tsx scripts/careers-prepare-test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "better-auth": "^1.7.17",
    "dotenv": "^18.0.9",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
