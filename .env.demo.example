# Arquivo local: copie para .env.demo. Nunca copie credenciais do projeto principal.
MYSTRA_ENV="demo"
DEMO_ACCESS_MODE="read-only"
PRIMARY_SUPABASE_PROJECT_REF=""
DEMO_SUPABASE_PROJECT_REF=""
HOMOLOG_SUPABASE_PROJECT_REF=""
DEMO_ISOLATED_CONFIRMED="false"
# Runtime: papel exclusivo mystra_demo_app; use o projeto demo e sslmode=verify-full.
DEMO_DATABASE_URL=""
# Owner/migrations: direct IPv6 ou session pooler IPv4 (5432) do MESMO projeto demo.
DEMO_DIRECT_URL=""
DEMO_BETTER_AUTH_SECRET=""
DEMO_BETTER_AUTH_URL="http://localhost:3001"
DEMO_OPERATION_CONFIRM=""
DEMO_RESTORE_CONFIRM=""
DEMO_MIGRATIONS_CONFIRM=""
# Apenas imagens autorizadas; bucket privado exclusivo. Upload público bloqueado.
DEMO_SUPABASE_URL=""
DEMO_STORAGE_SERVICE_ROLE_KEY=""
DEMO_STORAGE_BUCKET=""
SITE_URL=""
SITE_INDEXING_ENABLED="false"
CAREERS_MODE="demo"
